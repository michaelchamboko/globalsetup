#!/usr/bin/env sh
set -eu

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
NODE_BIN=""
for candidate in node nodejs; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit((a===22&&b>=18)||(a===24&&b>=11)||a>24?0:1)' >/dev/null 2>&1; then
    NODE_BIN="$candidate"
    break
  fi
done
if [ -z "$NODE_BIN" ]; then
  echo "repository guard requires Node.js 22.18+ or 24.11+" >&2
  exit 2
fi

"$NODE_BIN" "$REPOSITORY_ROOT/scripts/repository-guard.mts" --root "$REPOSITORY_ROOT" --staged
"$NODE_BIN" "$REPOSITORY_ROOT/scripts/repository-text.mts" --root "$REPOSITORY_ROOT" --staged

if [ -x "$REPOSITORY_ROOT/.githooks/pre-commit.user" ]; then
  "$REPOSITORY_ROOT/.githooks/pre-commit.user"
fi
