{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalSetup capabilities v2",
  "type": "object",
  "required": ["schema_version", "python", "workspace", "graph"],
  "properties": {
    "schema_version": {"const": 2},
    "python": {"type": "object"},
    "workspace": {"type": "object", "required": ["integration_branch", "serial"]},
    "graph": {
      "type": "object",
      "required": ["required", "provider", "version", "repository_alias", "branch", "license", "status_argv", "sync_argv"],
      "properties": {
        "required": {"const": true},
        "provider": {"const": "gitnexus"},
        "version": {"const": "1.6.10"},
        "repository_alias": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "license": {"type": "object", "required": ["spdx", "eligible"]},
        "status_argv": {"type": "array", "minItems": 1},
        "sync_argv": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
