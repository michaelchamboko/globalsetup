{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globalsetup.local/schemas/capabilities.schema.json",
  "title": "GlobalSetup capabilities",
  "type": "object",
  "required": ["schema_version", "python", "graph"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "python": {
      "type": "object",
      "required": ["required", "minimum_version"],
      "properties": {
        "required": {"const": true},
        "minimum_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": ["required", "provider", "license", "status_argv", "sync_argv"],
      "properties": {
        "required": {"const": true},
        "provider": {"const": "gitnexus"},
        "license": {
          "type": "object",
          "required": ["spdx", "usage", "acknowledged"],
          "properties": {
            "spdx": {"const": "PolyForm-Noncommercial-1.0.0"},
            "usage": {"const": "noncommercial"},
            "acknowledged": {"const": true}
          },
          "additionalProperties": false
        },
        "status_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sync_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
