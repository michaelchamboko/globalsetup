{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globalsetup.local/schemas/execution-state.schema.json",
  "title": "GlobalSetup execution state",
  "type": "object",
  "required": ["schema_version", "mode", "capabilities_file", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["mvp", "standard", "high_assurance"]},
    "capabilities_file": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "validation": {
      "type": "object",
      "required": ["name", "tier", "kind", "location"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "tier": {"enum": ["task", "affected", "full"]},
        "kind": {"enum": ["command", "receipt"]},
        "location": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "command"}}},
          "then": {"required": ["argv"], "properties": {"location": {"const": "local"}}},
          "else": {"not": {"required": ["argv"]}}
        }
      ],
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "dependencies",
        "risk",
        "source_changes",
        "context_files",
        "validation",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["blocked", "ready", "in_progress", "verified", "done"]},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risk": {"enum": ["low", "medium", "high"]},
        "source_changes": {"type": "boolean"},
        "context_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "validation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation"}},
        "evidence": {"type": "array"},
        "external_evidence": {"type": "array"}
      },
      "additionalProperties": true
    }
  }
}
