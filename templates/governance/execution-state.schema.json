{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globalsetup.local/schemas/execution-state.schema.json",
  "title": "GlobalSetup execution state v2",
  "type": "object",
  "required": ["schema_version", "mode", "capabilities_file", "source_manifest_file", "requirements_file", "grommet_file", "automation_authority", "tasks"],
  "properties": {
    "schema_version": {"const": 2},
    "mode": {"enum": ["mvp", "standard", "high_assurance"]},
    "capabilities_file": {"type": "string", "minLength": 1},
    "source_manifest_file": {"type": "string", "minLength": 1},
    "requirements_file": {"type": "string", "minLength": 1},
    "grommet_file": {"type": "string", "minLength": 1},
    "automation_authority": {"type": "object"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "title", "status", "dependencies", "risk", "risk_assessment", "source_changes", "requirement_ids", "context_files", "model_route", "context_packet", "validation", "evidence", "evidence_refs", "operation_phase"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["blocked", "ready", "in_progress", "verified", "integrated", "published", "done"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "risk": {"enum": ["low", "medium", "high"]},
        "risk_assessment": {"type": "object"},
        "source_changes": {"type": "boolean"},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "context_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "model_route": {"type": "object"},
        "context_packet": {"type": "object"},
        "validation": {"type": "array", "minItems": 1},
        "evidence": {"type": "array"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "operation_phase": {"type": "string"},
        "baseline_commit": {"type": "string"},
        "verified_commit": {"type": "string"},
        "integration_commit": {"type": "string"},
        "workspace": {"type": "object"},
        "publication": {"type": "object"},
        "review": {"type": "object"},
        "blocker": {"type": "object"},
        "external_evidence": {"type": "array"},
        "verification_history": {"type": "array"},
        "started_at": {"type": "string"},
        "verified_at": {"type": "string"},
        "integrated_at": {"type": "string"},
        "published_at": {"type": "string"},
        "completed_at": {"type": "string"},
        "extensions": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
